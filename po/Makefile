# gettext 工作流(Rust 源码,标准 GNU 流程):
#   make pot        源码变更后重新提取 po/fdebm.pot(xgettext)
#   make merge-po   将 pot 合并回各 *.po,保留既有翻译(未精确匹配的标记 fuzzy)
#   make mo         编译 *.po → locale/<lang>/LC_MESSAGES/fdebm.mo(msgfmt --check)
#   make install    安装 .mo 到 $(DESTDIR)/$(LOCALEDIR)/<lang>/LC_MESSAGES/
#   make check      校验各 .po 的格式与一致性
#   make lint       严格校验:头部字段、占位符、HTML 标签、fuzzy/废弃条目
#   make clean      清理编译产物(locale/)
#
# 源码内 msgid 经 gettext()/ngettext()/tf() 标注,提取关键字见 pot 目标。
# 本地运行(未安装):
#   make -C po mo
#   FDEBM_LOCALEDIR=$PWD/po/locale LC_ALL=zh_CN.utf8 cargo run -p fdebm-gtk

DOMAIN   ?= fdebm
VERSION  := $(shell sed -n 's/^version *= *"\(.*\)"/\1/p' ../Cargo.toml | head -1)
LOCALEDIR ?= /usr/share/locale
DESTDIR   ?=

# POTFILES.in 相对本目录,Makefile 内部以 ../ 前缀引用仓库根
POTFILES := $(shell sed -e 's/^#.*//' -e '/^$$/d' -e '/^\[/d' POTFILES.in | sed 's|^|../|')
POFILES  := $(filter-out $(DOMAIN).pot,$(wildcard *.po))
LANGS    := $(POFILES:.po=)
MOFILES  := $(LANGS:%=locale/%/LC_MESSAGES/$(DOMAIN).mo)

XGETTEXT ?= xgettext
MSGMERGE ?= msgmerge
MSGATTRIB ?= msgattrib
MSGFMT   ?= msgfmt
PYTHON   ?= python3

XGETTEXT_ARGS := --language=Rust --from-code=UTF-8 --add-comments=TRANSLATORS \
  --keyword=gettext --keyword=ngettext:1,2 --keyword=tf:1 \
  --package-name=$(DOMAIN) --package-version=$(VERSION) \
  --copyright-holder="fdebm contributors" \
  --msgid-bugs-address=sebastian.heinlein@web.de

# xgettext 输出的占位注释行与身份字段换成项目实际值
# (变量赋值里 # 需写成 \#,否则 make 会把它当成注释起始)
POT_SED := sed \
  -e 's|^\# SOME DESCRIPTIVE TITLE\.$$|\# Translation template for fdebm.|' \
  -e 's|^\# Copyright (C) YEAR .*$$|\# Copyright (C) fdebm contributors|' \
  -e 's|^\# This file is distributed under the same license as the .* package\.$$|\# Distributed under the terms of the GNU General Public License v3.0 or later.|' \
  -e 's|^\# FIRST AUTHOR <EMAIL@ADDRESS>, YEAR\.$$|\# Regenerate with "make -C po pot"; do not edit this file by hand.|' \
  -e 's|^"Last-Translator: FULL NAME <EMAIL@ADDRESS>\\n"$$|"Last-Translator: fdebm translators\\n"|' \
  -e 's|^"Language-Team: LANGUAGE <LL@li.org>\\n"$$|"Language-Team: fdebm translators\\n"|'

.PHONY: all pot merge-po mo install check lint clean

all: mo

$(DOMAIN).pot: $(POTFILES) POTFILES.in
	$(XGETTEXT) $(XGETTEXT_ARGS) -o $@.tmp $(POTFILES)
	$(POT_SED) $@.tmp > $@
	@rm -f $@.tmp

pot: $(DOMAIN).pot

# lint 禁止 fuzzy 与废弃条目:关闭猜测式匹配,新/改动条目保持未翻译;
# msgmerge 会把删掉的 msgid 留成 #~ 条目,一并清除
merge-po: $(DOMAIN).pot
	@for f in $(POFILES); do \
	  echo "  MSGMERGE $$f"; \
	  $(MSGMERGE) --update --backup=none --previous --no-fuzzy-matching $$f $(DOMAIN).pot || exit 1; \
	  $(MSGATTRIB) --no-obsolete $$f -o $$f.tmp && mv $$f.tmp $$f || exit 1; \
	done

mo: $(MOFILES)

locale/%/LC_MESSAGES/$(DOMAIN).mo: %.po
	@mkdir -p $(dir $@)
	$(MSGFMT) --check -o $@ $<

check: $(POFILES)
	@for f in $^; do $(MSGFMT) --check -o /dev/null $$f || exit 1; done

# 严格校验:头部/占位符/HTML 标签/fuzzy/废弃条目(CI 使用)
lint: $(POFILES) po_lint.py
	$(PYTHON) po_lint.py $(POFILES)

install: mo
	@for lang in $(LANGS); do \
	  install -Dm644 locale/$$lang/LC_MESSAGES/$(DOMAIN).mo \
	    $(DESTDIR)$(LOCALEDIR)/$$lang/LC_MESSAGES/$(DOMAIN).mo; \
	  echo "  INSTALL $$lang"; \
	done

clean:
	rm -rf locale
